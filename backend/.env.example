# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origins allowed by CORS (comma separated). The Next.js app normally proxies /api so this is a safety net.
CORS_ORIGINS=http://localhost:3000

# ── Database (SQLite) ────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Payments ─────────────────────────────────────────────
# "sandbox" = built-in development adapter (no real money moves, UI shows a SANDBOX banner)
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=USD
LICENCE_FEE_AMOUNT=49
# Reserved for a live provider adapter (never exposed to the frontend)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ── AI assistant ─────────────────────────────────────────
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, ...). Leave AI_API_KEY empty to use the offline assistant.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Rate limiting (requests per minute, per client) ──────
RATE_LIMIT=600
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=20
