# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origins allowed by CORS (comma separated). The Next.js app normally proxies /api so this is a safety net.
CORS_ORIGINS=http://localhost:3000

# ── Database (SQLite) ────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Licence fee collection (Cameroon Mobile Money) ────────
# "manual" = the bundled adapter: promoters pay with MTN Mobile Money (*126#) or Orange Money
# (#150#) to the merchant wallet an administrator sets in Admin → Licence fees, and an
# administrator confirms each transfer. Register a live aggregator (Campay, MeSomb, Notch Pay,
# MTN MoMo API, Orange Money API …) to settle transfers automatically.
# (An existing PAYMENT_PROVIDER=sandbox still boots: it now maps to the manual adapter.)
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=XAF
# Default fee used until an administrator sets the amount in Admin → Licence fees (whole FCFA).
LICENCE_FEE_AMOUNT=30000
# Reserved for a live aggregator adapter (never exposed to the frontend)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ── AI assistant (Groq by default) ───────────────────────
# Groq = fast open-weight models on LPUs (https://console.groq.com → API Keys).
# Paste the key below and the assistant is live; with no key it falls back to the
# built-in offline template writer and the UI says so.
AI_PROVIDER=groq
GROQ_API_KEY=
# Defaults to https://api.groq.com/openai/v1 and openai/gpt-oss-120b.
# Groq retired llama-3.3-70b-versatile and llama-3.1-8b-instant on 16 Aug 2026 (they now answer
# 404 "the model does not exist"), so do not pin them unless your key is an Enterprise one.
# Other current ids on the same key: openai/gpt-oss-20b (cheaper, ~1000 t/s) and qwen/qwen3.8-27b
# (preview). Live list: https://console.groq.com/docs/models
# GROQ_BASE_URL= / GROQ_MODEL= override them; AI_BASE_URL / AI_MODEL work as generic fallbacks.
# If a pinned GROQ_MODEL is unknown to Groq the backend retries once on openai/gpt-oss-20b and
# logs a warning instead of failing the request.
#
# Not to be confused with Grok (xAI): to use api.x.ai instead, set
#   AI_PROVIDER=grok / XAI_API_KEY=xai-... / XAI_MODEL=grok-4.7
# Any other OpenAI-compatible endpoint (OpenAI, OpenRouter, a proxy ...):
#   AI_PROVIDER=openai-compatible / AI_API_KEY=... / AI_BASE_URL=... / AI_MODEL=...
# AI_MAX_TOKENS is the length of the visible answer. Reasoning models (gpt-oss, Grok 4, Qwen3)
# think inside that same budget, so the backend multiplies it by 4 for them (capped at 8192).
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=45000

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Rate limiting (requests per minute, per client) ──────
RATE_LIMIT=600
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=20
