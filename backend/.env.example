# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origins allowed by CORS (comma separated). The Next.js app normally proxies /api so this is a safety net.
CORS_ORIGINS=http://localhost:3000

# ── Database (SQLite) ────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Licence fee collection (Cameroon Mobile Money) ────────
# "manual" = the bundled adapter: promoters pay with MTN Mobile Money (*126#) or Orange Money
# (#150#) to the merchant wallet an administrator sets in Admin → Licence fees, and an
# administrator confirms each transfer. Register a live aggregator (Campay, MeSomb, Notch Pay,
# MTN MoMo API, Orange Money API …) to settle transfers automatically.
# (An existing PAYMENT_PROVIDER=sandbox still boots: it now maps to the manual adapter.)
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=XAF
# Default fee used until an administrator sets the amount in Admin → Licence fees (whole FCFA).
LICENCE_FEE_AMOUNT=30000
# Reserved for a live aggregator adapter (never exposed to the frontend)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ── AI assistant (Grok / xAI) ────────────────────────────
# The assistant goes live as soon as a key is present: create one at https://console.x.ai
# ("API Keys") and paste it below. XAI_API_KEY is xAI's own name; AI_API_KEY and
# GROK_API_KEY are accepted as aliases. With no key the assistant falls back to the
# built-in offline template writer, and the UI says so.
AI_PROVIDER=grok
XAI_API_KEY=
# Defaults are xAI's; override only to proxy xAI or to use another OpenAI-compatible
# endpoint (OpenAI, OpenRouter, ...) together with AI_PROVIDER=openai-compatible.
AI_BASE_URL=https://api.x.ai/v1
# Flagship model; cheaper/faster alternatives: grok-4.3, grok-4-1-fast-non-reasoning
AI_MODEL=grok-4.7
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=60000

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Rate limiting (requests per minute, per client) ──────
RATE_LIMIT=600
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=20
