{
  "name": "talent-connect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Talent Connect REST API (NestJS + Prisma + SQLite)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:reset": "node -e \"['dev.db','dev.db-journal'].forEach(f=>require('fs').rmSync('prisma/'+f,{force:true}))\" && prisma migrate deploy && prisma db seed",
    "test": "node --require ts-node/register/transpile-only --test --test-reporter=spec --test-concurrency=1 test/app.e2e-spec.ts",
    "test:e2e": "node --require ts-node/register/transpile-only --test --test-reporter=spec --test-concurrency=1 test/app.e2e-spec.ts",
    "ai:check": "ts-node --transpile-only scripts/check-ai.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "expect": "^30.5.2",
    "globals": "^17.12.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}